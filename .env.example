# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# 32 random bytes, base64url. Losing it makes every stored product undecryptable. Never rotate without re-wrapping keys.
MASTER_KEY=
# Wallet that receives the 5% platform fee
TREASURY_WALLET=
# Comma-separated wallets allowed to see /admin and take products down
ADMIN_WALLETS=
# Optional: private server-side RPC (e.g. Helius). Falls back to NEXT_PUBLIC_RPC_URL
RPC_URL=
# Defaults to devnet USDC. Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_USDC_MINT=
